{
  "name": "termennetwerk-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the NDE Network of Terms (Termennetwerk): search, look up and reconcile Dutch cultural heritage terminology.",
  "type": "module",
  "mcpName": "io.github.coret/termennetwerk-mcp-server",
  "license": "EUPL-1.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coret/termennetwerk-mcp-server.git"
  },
  "homepage": "https://github.com/coret/termennetwerk-mcp-server#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "record": "tsx scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "graphql": "^16.15.0",
    "graphql-request": "^7.4.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
